// src/types.generated.ts from GaiaDesk's OpenAPI document: every schema in
// `components.schemas` as an `export interface` / `export type`, and each
// operation's query parameters as `<OperationId>Query`.
//
// Usage (Node 22.6+, no dependencies):
//   node --experimental-strip-types scripts/gen-types.mts [openapi.json path or URL]
// Default: https://api.gaiadesk.net/v1/openapi.json. The output is checked in;
// never edit it, regenerate it.

import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

export interface Schema {
  $ref?: string;
  const?: unknown;
  enum?: unknown[];
  oneOf?: Schema[];
  anyOf?: Schema[];
  allOf?: Schema[];
  type?: string | string[];
  items?: Schema;
  properties?: Record<string, Schema>;
  required?: string[];
  additionalProperties?: Schema | boolean;
  description?: string;
  [k: string]: unknown;
}

const refName = (ref: string): string => ref.replace(/^#\/components\/schemas\//, '');
/** Rustdoc intra-doc links (`` [`ErrorKind`] ``) read as plain code. */
const prose = (t: string): string => t.replace(/\[`([^`\]]+)`\](\([^)]*\))?/g, (_m, p: string) => '`' + p.split('::').slice(-2).join('::') + '`');
const doc = (s: Schema | undefined, indent = ''): string =>
  s?.description ? `${indent}/** ${prose(s.description).trimEnd().replace(/\*\//g, '*\\/').split('\n').join(`\n${indent} * `)} */\n` : '';
const paren = (t: string): string => (t.includes(' | ') || t.includes(' & ') ? `(${t})` : t);
const key = (k: string): string => (/^[A-Za-z_$][\w$]*$/.test(k) ? k : JSON.stringify(k));

export function ts(s: Schema | undefined, indent = ''): string {
  if (!s || typeof s !== 'object') return 'unknown';
  if (s.$ref) return refName(s.$ref);
  if (s.const !== undefined) return JSON.stringify(s.const);
  if (s.enum) return s.enum.map((v) => JSON.stringify(v)).join(' | ');
  const alts = s.oneOf ?? s.anyOf;
  if (alts) return alts.map((v) => paren(ts(v, indent))).join(' | ');
  if (s.allOf) return s.allOf.map((v) => paren(ts(v, indent))).join(' & ');
  if (Array.isArray(s.type)) return s.type.map((t) => ts({ ...s, type: t }, indent)).join(' | ');
  switch (s.type) {
    case 'string':
      return 'string';
    case 'integer':
    case 'number':
      return 'number';
    case 'boolean':
      return 'boolean';
    case 'null':
      return 'null';
    case 'array':
      return `Array<${ts(s.items, indent)}>`;
    case 'object': {
      if (s.properties) return object(s, indent);
      const ap = s.additionalProperties;
      return ap && ap !== true ? `Record<string, ${ts(ap, indent)}>` : 'Record<string, unknown>';
    }
  }
  return s.properties ? object(s, indent) : 'unknown';
}

function object(s: Schema, indent: string): string {
  const req = new Set(s.required ?? []);
  const lines = Object.entries(s.properties ?? {}).map(
    ([k, v]) => `${doc(v, indent + '  ')}${indent}  ${key(k)}${req.has(k) ? '' : '?'}: ${ts(v, indent + '  ')};`,
  );
  return `{\n${lines.join('\n')}\n${indent}}`;
}

interface Param {
  name: string;
  in: string;
  required?: boolean;
  description?: string;
  schema?: Schema;
  $ref?: string;
}

export function generate(spec: any): string {
  let out = `// GENERATED by scripts/gen-types.mts from GaiaDesk's OpenAPI document (${spec.info?.title ?? ''} ${spec.info?.version ?? ''}) — do not edit.\n\n`;
  const schemas: Record<string, Schema> = spec.components?.schemas ?? {};
  for (const n of Object.keys(schemas).sort()) {
    const s = schemas[n];
    out += doc(s);
    out += s.type === 'object' && s.properties && !s.allOf && !s.oneOf ? `export interface ${n} ${object(s, '')}\n\n` : `export type ${n} = ${ts(s)};\n\n`;
  }
  for (const item of Object.values<any>(spec.paths ?? {})) {
    for (const op of Object.values<any>(item)) {
      const query = ((op?.parameters ?? []) as Param[]).filter((p) => p.in === 'query');
      if (!op?.operationId || !query.length) continue;
      const name = op.operationId[0].toUpperCase() + op.operationId.slice(1) + 'Query';
      const props = query.map((p) => `${doc(p, '  ')}  ${key(p.name)}${p.required ? '' : '?'}: ${ts(p.schema, '  ')};`);
      out += `export interface ${name} {\n${props.join('\n')}\n}\n\n`;
    }
  }
  return out.trimEnd() + '\n';
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const src = process.argv[2] ?? 'https://api.gaiadesk.net/v1/openapi.json';
  const text = /^https?:/.test(src) ? await (await fetch(src)).text() : readFileSync(src, 'utf8');
  const out = join(dirname(fileURLToPath(import.meta.url)), '..', 'src', 'types.generated.ts');
  writeFileSync(out, generate(JSON.parse(text)));
  console.log(`wrote ${out}`);
}
